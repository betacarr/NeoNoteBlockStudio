{
  "name": "neo-noteblock-studio",
  "version": "0.1.58",
  "private": true,
  "description": "A MIDI-first desktop note block workstation with NBSX projects and NBS interoperability.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:lifecycle": "node scripts/smoke-file-lifecycle.mjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --x64 && node scripts/check-release.mjs",
    "package:mac": "npm run build && electron-builder --mac",
    "research:audio": "node scripts/research-audio.mjs",
    "audit:publication": "node scripts/check-publication.mjs",
    "install:hooks": "git config core.hooksPath .githooks",
    "prepare:preview": "node scripts/prepare-preview-samples.mjs",
    "prebuild": "npm run prepare:preview",
    "predev": "npm run prepare:preview",
    "predev:web": "npm run prepare:preview",
    "pretest": "npm run prepare:preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tonejs/midi": "2.0.28",
    "fflate": "0.8.3",
    "immer": "11.2.9",
    "koffi": "3.3.3",
    "midi-file": "1.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nbsjs/core": "6.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "latest",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "studio.exnoteblock.desktop",
    "productName": "NeoNBS",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "third_party/flp2nbs/LICENSE",
      "third_party/flp2nbs/NOTICE.txt",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/@phosphor-icons/**/*",
      "!node_modules/@tonejs/**/*",
      "!node_modules/array-flatten/**/*",
      "!node_modules/fflate/**/*",
      "!node_modules/immer/**/*",
      "!node_modules/midi-file/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/scheduler/**/*",
      "third_party/minecraft-samples/NOTICE.md",
      "third_party/minecraft-samples/manifest.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "dist-electron/java/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": ".local/release-assets/NeoNBS.ico"
    },
    "portable": {
      "artifactName": "NeoNBS-${version}-${arch}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "nsis": {
      "artifactName": "NeoNBS-${version}-${arch}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "NeoNBS",
      "license": "LICENSE",
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "fileAssociations": [
      {
        "ext": "nbsx",
        "name": "NeoNBS Project",
        "role": "Editor"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "betacarr"
  },
  "homepage": "https://github.com/betacarr/NeoNoteBlockStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/betacarr/NeoNoteBlockStudio.git"
  }
}
